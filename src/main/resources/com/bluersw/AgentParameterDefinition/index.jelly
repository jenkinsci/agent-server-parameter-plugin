<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define"
		 xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form"
		 xmlns:i="jelly:fmt" xmlns:p="/lib/hudson/project">
	<st:adjunct includes="com.bluersw.agentParameter"/>
	<f:entry title="${it.name}" description="${it.description}">
		<div name="parameter" id="${it.divId}" class="agent-server-parameter" style="white-space:nowrap"
			 data-update-url="${h.getCurrentDescriptorByNameUrl()}/${it.descriptor.descriptorUrl}/setDefaultValue"
			 data-parameter-name="${it.name}">
			<input type="hidden" name="name" value="${it.name}"/>
			<f:select class="agent-server-parameter-select" field="value" default="${it.defaultValue}" style="width:auto;"/>
			<div class="agent-server-parameter-message"></div>
		</div>
	</f:entry>
</j:jelly>
